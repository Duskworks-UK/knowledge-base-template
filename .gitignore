# Machine-specific configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Editor and operating-system state
.DS_Store
Thumbs.db
.idea/
.vscode/
.obsidian/
*.swp
*~

# Local caches and temporary work
.cache/
.tmp/
__pycache__/
*.pyc

# Inbox items are never committed: unprocessed captures and held items can
# contain material the filer hasn't checked or has refused. Filed items move
# to wiki/raw/, which is committed.
wiki/inbox/*
!wiki/inbox/.gitkeep
